# ===== Sumire プロジェクト固有 =====

# 下書き・スクラッチ
temp.md
scratch/
*.scratch.md

# Claude Code のチャットログ(/export 出力先など)。OSS 公開を見据えて追跡対象外。
docs/logs/

# 個別機能の作業記録(requirements / design / tasks)。手元の環境や検証の経過を
# 含むので、追跡対象外。恒久的な仕様は docs/spec/ に置く。
/.kiro/specs/

# Claude Code のローカル設定(必要に応じて一部だけ追跡する形に変えても良い)
.claude/settings.local.json

# Claude Desktop が「リポジトリの独立したコピーで作業」オプション選択時に
# 作る git worktree 置き場。本体ルート直下のみを除外し、worktree 内に
# 偶然できた同名パスには影響させない(先頭スラッシュで限定)。
/.claude/worktrees/

# ===== Node.js / フロントエンド =====

node_modules/
dist/
build/
.vite/
.cache/
*.tsbuildinfo

# パッケージマネージャ(複数を併用しないなら、使うものだけ残す)
.npm/
.pnpm-store/
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/unplugged

# ログ
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 環境変数
.env
.env.local
.env.*.local

# ===== Rust / Tauri =====

# Rust ビルド成果物
src-tauri/target/
target/

# Tauri の生成物
src-tauri/gen/schemas/
src-tauri/WixTools/
src-tauri/.cargo/

# `pnpm tauri icon` がついでに作るモバイル用アイコン群。
# Sumire はデスクトップ専用で bundle.icon に android/ios は含めない方針(roadmap
# の「採らない方針」参照)。マスター画像と desktop 用派生だけ追跡対象とする。
src-tauri/icons/android/
src-tauri/icons/ios/

# ===== ビルド成果物・中間ファイル(Vite/フロント追加分) =====

dist-ssr
*.local

# Visual Studio が生成する可能性のあるファイル
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== OS / エディタ =====

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.fuse_hidden*
.Trash-*

# JetBrains IDE
.idea/

# VS Code(ワークスペース固有設定は基本除外。共有したい設定だけ別途追跡)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# ===== テスト・カバレッジ =====

coverage/
*.lcov
.nyc_output/

# ===== Sumire の実行時生成物 =====
# (実装が進んだら必要に応じて整理)

# サンプル小説プロジェクトを開発用に置く場合は除外
sample-projects/

# アプリのローカルログ・キャッシュ
.sumire/

# dev 操作ログ(SUMIRE_DEV_LOG=1 で有効化、dogfood / 自動検証用)
dev-events.jsonl

# Obsidian
.obsidian/*
.trash/
